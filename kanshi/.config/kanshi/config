# Laptop only — built-in screen at native resolution, scale 1
profile default {
    output "BOE 0x0B8E" enable mode 1920x1080 scale 1 position 0,0
}

# Home desk — AOC on the right of the laptop screen
profile home {
    output "BOE 0x0B8E"          enable mode 1920x1080     scale 1 position 0,0
    output "AOC 24G2W1G3- AYAM91A000341" enable mode 1920x1080@144Hz scale 1 position 1920,0
}
