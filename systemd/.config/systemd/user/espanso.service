# espanso panics with NoCompositor if it starts before the compositor puts
# WAYLAND_DISPLAY into the systemd user environment. default.target starts
# this unit before that happens, in Plasma and in Hyprland. ExecStart waits
# up to 30 s for the variable and its socket, then starts espanso with it.
[Unit]
Description=espanso

[Service]
ExecStart=/bin/sh -c 'for i in $$(seq 60); do e=$$(systemctl --user show-environment | grep "^WAYLAND_DISPLAY="); if [ -n "$$e" ] && [ -S "$$XDG_RUNTIME_DIR/$${e#WAYLAND_DISPLAY=}" ]; then export "$$e"; exec /usr/bin/espanso launcher; fi; sleep 0.5; done; echo "no WAYLAND_DISPLAY after 30 s" >&2; exit 1'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
