# NWUStyle.sty completion file for TeXstudio
# Auto-generated completion definitions for North-West University thesis style

# Package declaration
#include:graphics
#include:graphicx
#include:hyperref
#include:amsmath
#include:amssymb
#include:amsthm
#include:tikz
#include:natbib
#include:adjustbox
#include:chngpage
#include:ifthen
#include:eso-pic
#include:geometry

# Required student information commands
\StudentNumber{student number}
\ORCID{ORCID identifier}
\Initials{initials}
\FirstName{first name}
\Surname{surname}
\Title{thesis title}
\MScorPhD{degree name}
\Field{field of study}
\GradDate{graduation date}
\Supervisor{supervisor name}
\CoSupervisor{co-supervisor name}
\AssistantSupervisor{assistant supervisor name}

# Citation commands
\cites{bibkey}#c

# Keywords command
\KeyWords{keywords}

# Document generation commands
\MakeTitle
\MakeTOCandLOFandLOT

# Environments
\begin{Acknowledgements}
\end{Acknowledgements}

\begin{Abstract}
\end{Abstract}

\begin{TableOfAbbrev}
\end{TableOfAbbrev}

# Internal commands (less commonly used directly)
\img{image path}
\printcosupervisor{name}
\printasssupervisor{name}
