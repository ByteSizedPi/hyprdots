// -*- mode: jsonc -*-
{
  "margin-bottom": 0,
  "margin-top": 3,
  "margin-right": 4,
  "margin-left": 4,
  // "margin-top": 0,

  "layer": "top",
  // "output": ["HDMI-A-1", "eDP-1"],
  // "output": "HDMI-A-1",

  "reload_style_on_change": true,

  "modules-left": [
    "hyprland/workspaces", // comment for fun
    "hyprland/window"
  ],
  "modules-center": [
    "group/actions",

    "custom/screenshot",
    "bluetooth",
    "custom/power-profile",
    "custom/docker",
    "custom/backlight"
  ],
  "modules-right": ["clock", "network", "battery", "custom/power"],

  "custom/notification": {
    "tooltip": false,
    "format": "",
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },

  "bluetooth": {
    "format": "󰂯",
    "format-on": "󰂯",
    "format-disabled": "󰂲",
    "format-off": "󰂲",
    "format-connected": "󰂯 {device_alias}",
    "format-connected-battery": "󰂯 {device_alias} <span>{device_battery_percentage}%</span>",
    "format-no-controller": "󰂲 lost...",
    "tooltip-format": "󰂯 {controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "󰂯 {controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth"
  },

  "hyprland/workspaces": {
    "format": "{name}"
  },

  "hyprland/window": {
    "format": "{class}",
    // "format": "{initialTitle}",
    "icon": true,
    "icon-size": 20
  },

  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%H:%M %a %d %b}",
    "tooltip": false
  },

  // "group/cpu-gp": {
  //   "orientation": "inherit",
  //   "modules": ["cpu", "custom/cpu-text"]
  // },

  "cpu": {
    "format": "{usage}% CPU",
    "on-click": "kitty -e btop",
    "interval": 1
  },

  // "custom/cpu-text": {
  //   "format": "CPU"
  // },

  "memory": {
    "format": "{}% RAM",
    "on-click": "kitty -e btop",
    "interval": 1
  },

  // "custom/ram-text": {
  //   "format": "RAM"
  // },

  // "group/ram-gp": {
  //   "orientation": "inherit",
  //   "modules": ["memory", "custom/ram-text"]
  // },

  "battery": {
    "states": {
      "good": 100,
      "warning": 40,
      "critical": 15
    },
    "format": "{capacity} {icon}",
    "format-charging": "{capacity} ",
    "format-plugged": "{capacity} ",
    "format-icons": ["", "", "", "", ""],
    "interval": 1
  },

  "custom/power-profile": {
    "exec": "/home/jj/.local/bin/custom_bin/juicectl-status",
    "on-click": "/home/jj/.local/bin/custom_bin/juicectl-cycle",
    "return-type": "json",
    "interval": 1,
    "format": "{icon}",
    "format-icons": {
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

  "network": {
    "format-wifi": "{essid} {icon}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname} via {gwaddr}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Disconnected 󰤭",
    "format-disabled": "Disabled 󰤭",
    "interval": 1,
    "format-icons": {
      "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"]
    },
    "on-click": "nmgui"
  },

  "group/actions": {
    "orientation": "inherit",
    "modules": ["cpu", "memory", "pulseaudio", "brightness", "custom/updates"]
  },

  "custom/screenshot": {
    "format": "󰆟",
    "on-click": "~/.local/bin/custom_bin/screenshot.sh"
  },

  "custom/backlight": {
    "format": "",
    "exec": "~/.config/waybar/scripts/backlight-status.sh &",
    "return-type": "json",
    "interval": 1,
    "on-click": "/home/jj/.local/bin/custom_bin/toggle-backlight.sh"
  },

  "pulseaudio": {
    "format": "{volume} {icon}",
    "format-muted": "󰖁 {volume}",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/menus/power_menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "logout": "hyprctl dispatch exit",
      "shutdown": "shutdown now",
      "reboot": "reboot"
    }
  },

  "custom/updates": {
    "format": "{text} {icon}",
    "exec": "ezpac status --waybar",
    "on-click": "ezpac update --terminal",
    "on-click-right": "ezpac check &",
    "return-type": "json",
    "interval": 1,
    "format-icons": {
      "checking": "",
      "updating": "󰜷",
      "idle": ""
    }
  },

  // "group/updates": {
  //   "orientation": "inherit",
  //   "drawer": {
  //     "transition-duration": 200,
  //     "children-class": "not-updates",
  //     "transition-left-to-right": false
  //   },
  //   "modules": ["custom/updates", "custom/updates-full"]
  // },

  "custom/docker": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/docker-status.sh &",
    "return-type": "json",
    "interval": 1,
    "on-click": "~/.config/waybar/scripts/toggle-docker.sh toggle",
    "signal": 8,
    "tooltip": true
  }
}
