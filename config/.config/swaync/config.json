{
    "$schema": "/etc/xdg/swaync/configSchema.json",
    "positionX": "left",
    "positionY": "top",
    "notification-body-image-height": 200,
    "notification-body-image-width": 200,
    "control-center-margin-top": 5,
    "control-center-margin-bottom": 5,
    "control-center-margin-right": 0,
    "control-center-margin-left": 5,
    "control-center-width": 350,
    "timeout": 10,
    "timeout-low": 5,
    "timeout-critical": 0,
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "widgets": [
        "label",
        "buttons-grid",
        "volume",
        "backlight",
        "mpris",
        "title",
        "notifications"
    ],
    "widget-config": {
        "buttons-grid": {
            "actions": [
                {
                    "label": "󰂯",
                    "command": "bluetoothctl power toggle"
                },
                {
                    "label": "",
                    "type": "toggle",
                    "command": "/home/jj/.config/swaync/toggle-backlight.sh",
                    "update-command": "/home/jj/.config/swaync/kbd_backlight.sh"
                },
                {
                    "label": "󰆟",
                    "command": "/home/jj/.config/swaync/screenshot.sh"
                }
            ]
        },
        "title": {
            "text": "󰂚 Notifications",
            "clear-all-button": true,
            "button-text": " Clear All"
        },
        "dnd": {
            "text": "󰂚 Do Not Disturb"
        },
        "label": {
            "max-lines": 1,
            "text": "Control Center"
        }
    }
}