// Hand-authored baseline, mirroring ~/dotfiles/hyprland as closely as niri's
// model allows. Deferred to a later pass: scratchpad equivalents for
// zellij/jjserver (niri has no scratchpad primitive), and output blocks for
// the external monitors (run `niri msg outputs` after first login to get
// their exact description strings, then add them here).

input {
    keyboard {
        xkb {
        }
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }

    focus-follows-mouse max-scroll-amount="0%"
}

// Laptop panel only for now. Scale stays 1 for the same reason it does in
// modules/monitors.lua: fractional auto-scale breaks logical-pixel layout math.
output "eDP-1" {
    mode "1920x1080@60"
    position x=0 y=0
    scale 1
}

layout {
    gaps 4
    // Using focus-ring, not border, to match Hyprland's single 2px outline —
    // border in niri reserves extra space and shrinks windows, focus-ring doesn't.
    focus-ring {
        width 2
    }
}

spawn-at-startup "noctalia"

// Colors come from the rendered template below, not hardcoded here — same
// mechanism as noctalia.lua on the Hyprland side. Regenerated by
// `noctalia msg templates-apply`; see ../../.gitignore.
include "noctalia.kdl"

window-rule {
    geometry-corner-radius 8
    clip-to-geometry true
}

window-rule {
    // Verify this app-id after first login; unconfirmed against a live niri session.
    match app-id=r#"dev\.noctalia\.Noctalia\.Settings$"#
    opacity 0.8
}

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+Return { spawn "xdg-terminal-exec"; }
    Mod+Q      { close-window; }
    Mod+E      { spawn "dolphin"; }
    Mod+F      { fullscreen-window; }
    Mod+V      { toggle-window-floating; }

    Mod+Space      { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+N          { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+W          { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+M          { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Mod+Comma      { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+Alt+Escape { spawn "noctalia" "msg" "session" "lock"; }

    // niri already defaults these exact combos to the same actions.
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // Hyprland used Shift for "move"; niri's own default uses Ctrl for this.
    // Remapped to Shift here to match your muscle memory.
    Mod+Shift+H { move-column-left; }
    Mod+Shift+L { move-column-right; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }

    // niri workspaces are per-monitor already, so there is no separate
    // "monitor-scoped" step the way Hyprland's m-1/m+1 needed.
    Mod+Alt+H       { focus-workspace-up; }
    Mod+Alt+L       { focus-workspace-down; }
    Mod+Alt+Shift+H { move-column-to-workspace-up; }
    Mod+Alt+Shift+L { move-column-to-workspace-down; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    Mod+WheelScrollDown { focus-workspace-down; }
    Mod+WheelScrollUp   { focus-workspace-up; }

    Print { spawn "noctalia" "msg" "screenshot-fullscreen"; }

    XF86AudioRaiseVolume  allow-when-locked=true repeat=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true repeat=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute      allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true repeat=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true repeat=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioNext  allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioPause allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPlay  allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}
