// niri config — ~/.config/niri/config.kdl
// Wiki: https://niri-wm.github.io/niri/  (written against niri 26.04)
//
// This file is a table of contents. Each include mirrors one Hyprland module in
// ~/dotfiles/hyprland/.config/hypr/, and each file says where niri differs.
// docs/niri.md has the full Hyprland -> niri map and the open items.
//
// Includes are positional: a later file overrides keys set by an earlier one.

include "startup.kdl"     // modules/environment.lua + modules/autostart.lua
include "input.kdl"       // modules/input.lua
include "outputs.kdl"     // modules/monitors.lua
include "layout.kdl"      // modules/behaviour.lua, layouts.lua, theme/appearance.lua
include "animations.kdl"  // the animation part of theme/appearance.lua
include "rules.kdl"       // rules/windows.lua + theme/layers.lua
include "scratchpads.kdl" // modules/scratchpads.lua (named workspaces, not special ones)
include "binds.kdl"       // modules/keybinds.lua + modules/voxtype.lua

// Noctalia's palette goes LAST so its colours win, the same rule as
// require("noctalia").apply_theme() in hyprland.lua. Noctalia's template hook
// (/usr/share/noctalia/assets/templates/niri/apply.sh) greps this file for the
// literal include line below and appends a copy if it does not find one.
// Do not move or reword it.
include "noctalia.kdl"
