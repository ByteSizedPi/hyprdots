#!/bin/sh
# greetd greeter wrapper: load the noctalia palette into this VT, then start tuigreet.
# Installed to /usr/local/bin/tuigreet-themed (see SYSTEM.md -> "greetd: noctalia colors").
# noctalia renders /var/lib/greetd-theme/palette (16 lines of RRGGBB) on every theme change.
# If the file is missing or unreadable, tuigreet starts with the stock console colors.
palette=/var/lib/greetd-theme/palette
if [ -r "$palette" ]; then
	i=0
	while read -r rgb && [ "$i" -lt 16 ]; do
		case "$rgb" in
		[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F])
			# Linux console escape: ESC ] P <slot as one hex digit> <rrggbb>
			printf '\033]P%x%s' "$i" "$rgb"
			;;
		esac
		i=$((i + 1))
	done <"$palette"
	# Clear with the new slot 0 so the whole screen takes the background colour.
	printf '\033[2J\033[H'
fi
exec tuigreet "$@"
