# VSCode - Ignore everything in Code directory
config/.config/Code/*

# But keep the important user configs
!config/.config/Code/User/
config/.config/Code/User/*
!config/.config/Code/User/settings.json
!config/.config/Code/User/keybindings.json
!config/.config/Code/User/tasks.json
!config/.config/Code/User/snippets/

# zellij — zjstatus binary (install manually: download from github.com/dj95/zjstatus/releases)
zellij/.config/zellij/plugins/*.wasm

# home/.config is NOT managed here — use nvim/, zellij/, kitty/ packages instead
home/.config/
# old XFWM theme assets, not in use
home/.themes/

# Noctalia-generated files — regenerated on every theme change.
# These are outputs, not inputs — no need to track them in git.
#
# Packages where ~/.config/<app> is a directory symlink into dotfiles
# (noctalia writes directly here):
hyprland/.config/hypr/noctalia.lua
kitty/.config/kitty/themes/noctalia.conf
zellij/.config/zellij/themes/noctalia.kdl
noctalia/.config/noctalia/colors.json
#
# Packages using --no-folding (generated files stay in real ~/.config dirs,
# not in dotfiles). These patterns are a safety net for fresh-machine stows.
alacritty/.config/alacritty/themes/
btop/.config/btop/themes/
yazi/.config/yazi/flavors/

# General patterns to avoid
*.log
*.tmp
.DS_Store
*~
*.swp
*.swo
