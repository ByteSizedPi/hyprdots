themes {
    catppuccin-macchiato-custom {
        // Base colors from Catppuccin Macchiato
        text_unselected {
            base 202 211 245      // text (lavender-ish)
            background 24 25 38   // crust - RIBBON BACKGROUND (transparent-ish) (#181926)
            emphasis_0 245 169 127  // peach
            emphasis_1 145 215 227  // sky
            emphasis_2 138 173 244  // blue - mode indicator in NORMAL (#8aadf4)
            emphasis_3 245 189 230  // pink
        }
        text_selected {
            base 202 211 245      // text
            background 91 96 120  // surface1
            emphasis_0 245 169 127  // peach
            emphasis_1 145 215 227  // sky
            emphasis_2 237 135 150  // red - mode indicator in other modes (#ed8796)
            emphasis_3 245 189 230  // pink
        }

        // CUSTOMIZED: Active tab and mode indicator
        // background = active tab/mode background color
        // base = active tab/mode text color
        ribbon_selected {
            base 24 25 38         // crust - text on active elements (#181926)
            background 138 173 244  // blue - active tab background (#8aadf4)
            emphasis_0 237 135 150  // red (#ed8796)
            emphasis_1 245 169 127  // peach
            emphasis_2 245 189 230  // pink
            emphasis_3 138 173 244  // blue
        }

        // CUSTOMIZED: Inactive tabs
        // background = odd index tab background (crust)
        // base = text for odd index tabs
        // emphasis_1 = even index tab background (lighter than crust)
        ribbon_unselected {
            base 202 211 245      // text - light lavender for odd tabs
            background 24 25 38   // crust - background for odd tabs (#181926)
            emphasis_0 237 135 150  // red
            emphasis_1 49 50 68   // mantle - lighter than crust for even tabs (#313244)
            emphasis_2 30 32 48   // base
            emphasis_3 110 115 141  // overlay0
        }

        table_title {
            base 166 218 149      // green
            background 0 0 0
            emphasis_0 245 189 230  // pink
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 138 173 244  // blue
        }
        table_cell_selected {
            base 202 211 245      // text
            background 91 96 120  // surface1
            emphasis_0 245 189 230  // pink
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 138 173 244  // blue
        }
        table_cell_unselected {
            base 202 211 245      // text
            background 30 32 48   // base
            emphasis_0 245 189 230  // pink
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 138 173 244  // blue
        }

        list_selected {
            base 202 211 245      // text
            background 91 96 120  // surface1
            emphasis_0 245 189 230  // pink
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 138 173 244  // blue
        }
        list_unselected {
            base 202 211 245      // text
            background 30 32 48   // base
            emphasis_0 245 189 230  // pink
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 138 173 244  // blue
        }

        // CUSTOMIZED: Pane borders - using Lavender for active, dimmer for inactive
        frame_selected {
            base 183 189 248      // lavender - visible but not too bright
            background 0 0 0
            emphasis_0 245 169 127  // peach
            emphasis_1 238 212 159  // yellow
            emphasis_2 166 218 149  // green
            emphasis_3 0 0 0
        }
        frame_unselected {
            base 110 115 141      // overlay0 - dimmed border
            background 0 0 0
            emphasis_0 91 96 120    // surface1
            emphasis_1 165 173 203  // subtext0
            emphasis_2 110 115 141  // overlay0
            emphasis_3 0 0 0
        }

        // CUSTOMIZED: Frame highlight (when in resize/move mode) - using Peach
        frame_highlight {
            base 245 169 127      // peach - warm highlight color
            background 0 0 0
            emphasis_0 245 169 127  // peach
            emphasis_1 245 169 127  // peach
            emphasis_2 245 169 127  // peach
            emphasis_3 245 169 127  // peach
        }

        exit_code_success {
            base 166 218 149      // green
            background 0 0 0
            emphasis_0 139 213 202  // teal
            emphasis_1 0 0 0
            emphasis_2 245 189 230  // pink
            emphasis_3 91 96 120    // surface1
        }
        exit_code_error {
            base 237 135 150      // red
            background 0 0 0
            emphasis_0 238 212 159  // yellow
            emphasis_1 0 0 0
            emphasis_2 0 0 0
            emphasis_3 0 0 0
        }

        multiplayer_user_colors {
            player_1 245 189 230   // pink
            player_2 138 173 244   // blue
            player_3 238 212 159   // yellow
            player_4 145 215 227   // sky
            player_5 237 135 150   // red
            player_6 245 169 127   // peach
            player_7 166 218 149   // green
            player_8 139 213 202   // teal
            player_9 183 189 248   // lavender
            player_10 198 160 246  // mauve
        }
    }
}
